{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "ignoreCommand": "test ! -s source/js/swarm-web.js || test ! -s source/js/luomo-swarm.js || test ! -s scripts/luomo-swarm-boot.js",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "framework": "hexo",
  "functions": {
    "api/status.js": { "maxDuration": 10 },
    "api/visitors.js": { "maxDuration": 10 }
  },
  "redirects": [
    {
      "source": "/:path((?!march7th/|robots\\.txt$|sitemap\\.xml$|llms\\.txt$|75a69cf4a84876a314f8d3108ab52655\\.txt$).+)",
      "has": [{ "type": "host", "value": { "eq": "march7th.cn" } }],
      "destination": "https://blog.luomo.moe/:path",
      "statusCode": 301
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    {
      "source": "/march7th",
      "missing": [{ "type": "host", "value": { "eq": "march7th.cn" } }],
      "destination": "https://march7th.cn/",
      "statusCode": 301
    },
    {
      "source": "/march7th/:path(.*)",
      "missing": [{ "type": "host", "value": { "eq": "march7th.cn" } }],
      "destination": "https://march7th.cn/",
      "statusCode": 301
    },
    { "source": "/favicon.ico", "destination": "/img/logo-192.png", "statusCode": 302 }
  ],
  "rewrites": [
    {
      "source": "/build-log/merges.json",
      "destination": "https://raw.githubusercontent.com/luomo66ccff/hexo/build-log-data/merges.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, must-revalidate"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/api/status",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
