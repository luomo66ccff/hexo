if theme.menu
  //- luomo: menuScope (desktop/sidebar) gives each disclosure a unique id.
  - let groupIndex = 0
  .menus_items
    each value, label in theme.menu
      if typeof value !== 'object'
        .menus_item
          - const [link, icon] = value.split('||').map(part => trim(part))
          a.site-page(href=url_for(link))
            if icon
              i.fa-fw(class=icon)
            span= ' ' + label
      else
        .menus_item(data-nav-menu)
          - const [groupLabel, groupIcon, groupClass] = label.split('||').map(part => trim(part))
          - const hideClass = groupClass === 'hide' ? 'hide' : ''
          - const menuId = `${menuScope}-menu-${groupIndex++}`
          button.site-page.group(type='button' class=hideClass data-nav-toggle aria-expanded=(menuScope === 'sidebar' && !hideClass ? 'true' : 'false') aria-controls=menuId)
            if groupIcon
              i.fa-fw(class=groupIcon)
            span= ' ' + groupLabel
            i.fas.fa-chevron-down
          ul.menus_item_child(id=menuId)
            each val, lab in value
              - const [childLink, childIcon] = val.split('||').map(part => trim(part))
              li
                a.site-page.child(href=url_for(childLink))
                  if childIcon
                    i.fa-fw(class=childIcon)
                  span= ' ' + lab