nav#nav
  span#blog-info
    a(href=url_for('/') title=config.title)
      if theme.nav.logo
        img.site-icon(src=url_for(theme.nav.logo))
      if theme.nav.display_title
        span.site-name=config.title
    
  #menus
    if (theme.algolia_search.enable || theme.local_search.enable || theme.docsearch.enable)
      #search-button
        button.site-page.social-icon.search(type='button' aria-label=_p('search.title') aria-haspopup='dialog' aria-controls='local-search')
          i.fas.fa-search.fa-fw
          span=' '+_p('search.title')
    !=partial('includes/header/menu_item', {menuScope: 'desktop'})

    #toggle-menu
      button.site-page(type='button' aria-label='打开导航菜单' aria-expanded='false' aria-controls='sidebar-menus')
        i.fas.fa-bars.fa-fw


